# ── SELF-HEALING IMPORTS ─────────────────────────────────────────────────────
# A Windows Python upgrade installs a fresh library folder, which silently
# removes requests/Pillow and kills the monitor on next boot. Instead of dying,
# reinstall them on the spot and carry on. This makes the known
# "monitor stopped after a Python update" failure mode heal itself.
# AND WITHOUT THEM, STILL A WATCHER (Oct 2026, from pilot facility's 09-27 addendum): a PC
# with no internet could not reinstall them, the import failed, and the bay had no
# watcher at all - no popup, no reserved screen. The reinstall is tried once, briefly;
# if they are still missing the standard library polls and Tk reads the QR PNGs itself.
requests = None
Image = ImageTk = None


def _try_imports():
    global requests, Image, ImageTk
    try:
        import requests as _requests
        requests = _requests
    except Exception:
        pass
    try:
        from PIL import Image as _Image, ImageTk as _ImageTk
        Image, ImageTk = _Image, _ImageTk
    except Exception:
        pass


_try_imports()
if requests is None or Image is None:
    try:
        subprocess.call([sys.executable, "-m", "pip", "install", "--quiet", "--disable-pip-version-check",
                         "--timeout", "8", "--retries", "1", "requests", "Pillow"], timeout=90)
    except Exception:
        pass
    _try_imports()

# ── SHARP ON A SCALED SCREEN (Sep 27 2026) ────────────────────────────────────
# Windows only, once, at startup, before any window: the monitor says it is DPI-aware, so a bay
# PC at 125-175% scaling hands it real pixel sizes and the popup below is laid out from them - its
# X and Close stay on the screen. Guarded: an older Windows without the call carries on as before.
def _declare_dpi_aware():
    if not sys.platform.startswith("win"):
        return
    try:
        ctypes.windll.shcore.SetProcessDpiAwareness(2)   # per-monitor aware (Windows 8.1 and later)
    except Exception:
        try:
            ctypes.windll.user32.SetProcessDPIAware()     # system aware (older Windows)
        except Exception:
            pass


_declare_dpi_aware()

# ── COLORS (match the booking site theme) ────────────────────────────────────
BG      = "#0a0f0a"
PANEL   = "#161e16"
ACCENT  = "#c9a227"
TEXT    = "#e8ede8"
MUTED   = "#93a593"
CLOSE_RED = "#e53935"

# ── THE EXTEND POPUP ──────────────────────────────────────────────────────────
POPUP_SECS = 120     # closes itself after two minutes, counting down on screen
X_MIN_PX   = 48      # the red X is never smaller than this, at any scaling

# The booking this PC last warned about survives a reboot here, beside the program. Anything
# wrong with the file - missing, unreadable, unwritable - means carrying on as before: the popup
# may show twice, never not at all, and the monitor never stops over it.
STATE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "session-monitor-state.json")

# The battery's window into the popup's layout. Unset on a bay PC, where nothing is written.
PROBE_FILE = os.environ.get("BA_WATCHER_PROBE", "")

# ── STATE ─────────────────────────────────────────────────────────────────────
last_warned_booking = None   # bookingId we already warned for (warn once per booking)
_last_status        = None   # the unit's latest reply - the wrap-up says when the next group really starts
blank_windows       = []     # open fullscreen blank windows
_blank_stop         = None   # the reserved screen's stop signal (a threading.Event) while it is up
_hotkey_started     = False  # the staff hotkey's thread, started once
popup_window        = None   # the current warning popup, if any
admin_override      = False  # staff kill code pressed - stay unblanked


# ── WARN ONCE PER BOOKING, ACROSS A RESTART ───────────────────────────────────
def load_warned():
    """The booking already warned about, from before a restart - or None."""
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        bid = data.get("bookingId") if isinstance(data, dict) else None
        return bid if isinstance(bid, str) and bid else None
    except Exception:
        return None


def save_warned(bid):
    """Best effort: a file that cannot be written changes nothing but the next restart."""
    try:
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"bookingId": bid, "at": int(time.time())}, f)
        os.replace(tmp, STATE_FILE)
    except Exception:
        pass


def _probe(data):
    if not PROBE_FILE:
        return
    try:
        with open(PROBE_FILE, "a", encoding="utf-8") as f:
            f.write(json.dumps(data) + "\n")
    except Exception:
        pass


def _no_activate(win, on):
    """Windows: the popup is shown without taking the keyboard from the game (WS_EX_NOACTIVATE),
    and a click on it gives it the keyboard so Esc reaches it. Elsewhere, or on any failure, nothing."""
    if not sys.platform.startswith("win"):
        return
    try:
        u = ctypes.windll.user32
        try:
            hwnd = int(win.wm_frame(), 16)
        except Exception:
            hwnd = u.GetParent(win.winfo_id()) or win.winfo_id()
        GWL_EXSTYLE, WS_EX_NOACTIVATE = -20, 0x08000000
        style = u.GetWindowLongW(hwnd, GWL_EXSTYLE)
        u.SetWindowLongW(hwnd, GWL_EXSTYLE, (style | WS_EX_NOACTIVATE) if on else (style & ~WS_EX_NOACTIVATE))
    except Exception:
        pass


# ── SERVER POLL ────────────────────────────────────────────────────────────────
def get_status():
    """Ask the booking system what's happening on this bay. Never raises.
    The unit on the facility's network first; its public address only when that
    does not answer - the unit's LAN address changed, or a spare was swapped in."""
    for url in (f"{SERVER_URL}/api/session/status",
                f"{FALLBACK_URL}/api/session/status" if FALLBACK_URL else ""):
        if not url:
            continue
        # with each poll, whether the reserved screen is up (Oct 2026): the unit restarts a PC before the next
        # group only when this watcher kept the screen up through the gap (never after staff's kill code)
        bs = globals().get("_blank_stop")
        params = {"bay": BAY_ID}
        # not on the very first poll after the watcher starts (Oct 2026, the pack review): it has drawn nothing yet,
        # so "down" there is not staff taking the screen down - a PC just woken would be blamed for it
        if globals().get("_last_status") is not None:
            params["guard"] = "1" if (bs is not None and not bs.is_set()) else "0"
        try:
            if requests is not None:
                r = requests.get(url, params=params, timeout=10)
                if r.ok:
                    return r.json()
            else:
                # no requests on this PC: the standard library asks the same thing (an error status raises)
                import urllib.parse
                import urllib.request
                with urllib.request.urlopen(url + "?" + urllib.parse.urlencode(params), timeout=10) as resp:
                    return json.loads(resp.read().decode("utf-8"))
        except Exception:
            pass
    return None


# ── IMAGE HELPERS ─────────────────────────────────────────────────────────────
def b64_photo(b64_string, max_px, master=None):
    """Decode a base64 PNG and return a Tk PhotoImage scaled to max_px wide/tall, made for the
    window it will be shown in (master). Returns None if the string is empty or invalid.
    Without Pillow, Tk reads the PNG itself and shrinks it by a whole factor - a little coarser,
    never missing."""
    if not b64_string:
        return None
    try:
        if Image is not None:
            raw = base64.b64decode(b64_string)
            img = Image.open(io.BytesIO(raw))
            img.thumbnail((max_px, max_px), Image.LANCZOS)
            return ImageTk.PhotoImage(img, master=master)
        photo = tk.PhotoImage(master=master, data=b64_string)
        f = max(1, -(-max(photo.width(), photo.height()) // max(1, int(max_px))))
        return photo.subsample(f, f) if f > 1 else photo
    except Exception:
        return None


# ── MONITOR ENUMERATION (blank every attached screen) ─────────────────────────
def get_monitors():
    """Return [(x, y, w, h), ...] for every attached display via the Win32 API.
    Falls back to a single 1920x1080 monitor if enumeration fails."""
    monitors = []
    try:
        user32 = ctypes.windll.user32

        MONITORENUMPROC = ctypes.WINFUNCTYPE(
            ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong,
            ctypes.POINTER(ctypes.c_long * 4), ctypes.c_double
        )

        def cb(hMonitor, hdc, lprect, lparam):
            r = lprect.contents
            monitors.append((r[0], r[1], r[2] - r[0], r[3] - r[1]))
            return 1

        user32.EnumDisplayMonitors(0, 0, MONITORENUMPROC(cb), 0)
    except Exception:
        pass
    if not monitors:
        monitors = [(0, 0, 1920, 1080)]
    return monitors


# ── WARNING POPUP (bay open afterward - "add more time" with QR) ──────────────
def show_extend_popup(mins_left, wrapup=False):
    """Always-on-top window, bottom-left, with the bay QR - or, with wrapup=True, the same panel with no QR
    telling the group the next one is coming (Oct 2026: it was a Windows message box that took the
    keyboard from the game and had to be clicked away). Closed by the red X, the Close button,
    or Esc once it has been clicked; closes itself after POPUP_SECS with a countdown on screen.
    Sized from its content and the screen at whatever scaling the PC runs (the QR gives way, never
    the Close button), shown without taking the keyboard from the game. Runs on a daemon thread so
    polling never blocks on the UI."""
    def run():
        global popup_window
        try:
            win = tk.Tk()
            win.withdraw()                 # built and measured first, then shown once
            popup_window = win
            win.title(BAY_NAME)
            win.configure(bg=PANEL)
            win.overrideredirect(True)
            win.attributes("-topmost", True)

            scale = float(win.tk.call("tk", "scaling"))   # pixels per point here: 1.33 at 100%, 2.33 at 175%

            def px(points):
                return max(1, int(round(points * scale)))

            sw, sh = win.winfo_screenwidth(), win.winfo_screenheight()
            margin = max(12, px(12))
            xs = max(X_MIN_PX, px(26))
            state = {"closed": False, "left": POPUP_SECS}

            def close(event=None):
                if state["closed"]:
                    return
                state["closed"] = True
                _probe({"event": "closed"})
                try:
                    win.destroy()
                except Exception:
                    pass

            frame = tk.Frame(win, bg=PANEL, highlightbackground=ACCENT, highlightthickness=2)
            frame.pack(fill="both", expand=True)

            # the bottom rows FIRST: packed before the QR, so a small or scaled screen shrinks the QR
            bottom = tk.Frame(frame, bg=PANEL)
            bottom.pack(side="bottom", fill="x", pady=(0, px(10)))
            if not wrapup:
                tk.Label(bottom, text=SITE_URL, font=("Segoe UI", 12),
                         fg=ACCENT, bg=PANEL).pack(pady=(px(4), 0))
            close_btn = tk.Button(bottom, text="Close", font=("Segoe UI", 13, "bold"),
                                  command=close, bg=BG, fg=TEXT, activebackground=ACCENT,
                                  activeforeground=BG, relief="flat", cursor="hand2",
                                  padx=px(18), pady=px(5))
            close_btn.pack(pady=(px(8), 0))
            countdown = tk.Label(bottom, text="", font=("Segoe UI", 11), fg=MUTED, bg=PANEL)
            countdown.pack(pady=(px(6), 0))

            top = tk.Frame(frame, bg=PANEL)
            top.pack(side="top", fill="x")
            tk.Label(top, text=f"{mins_left} minutes left", font=("Segoe UI", 26, "bold"),
                     fg=TEXT, bg=PANEL).pack(pady=(xs + px(4), px(2)), padx=px(16))
            tk.Label(top, text=f"on {BAY_NAME}", font=("Segoe UI", 13),
                     fg=MUTED, bg=PANEL).pack()
            nxt = None
            if wrapup:
                # maintainer, Oct 2 2026: "the next players are coming in 10 min you have 10 min left. So
                # something nice to say you are done"
                nxt = (_last_status or {}).get("minsUntilNext")
                # the line about the next group only when a group really follows this one (Oct 2026): at closing,
                # or a gap too short to book, there is no group in a few minutes - just the thanks
                nxt = nxt if isinstance(nxt, int) and 0 < nxt <= mins_left + 5 else None
                if nxt:
                    tk.Label(top, text=f"The next group starts in {nxt} minutes.", font=("Segoe UI", 14),
                             fg=TEXT, bg=PANEL).pack(pady=(px(14), px(4)), padx=px(16))
                tk.Label(top, text="Thanks for playing - please wrap up your round.", font=("Segoe UI", 14),
                         fg=ACCENT, bg=PANEL).pack(pady=(0 if nxt else px(14), px(12)), padx=px(16))
            else:
                tk.Label(top, text="Add more time to your session:", font=("Segoe UI", 14),
                         fg=TEXT, bg=PANEL).pack(pady=(px(14), px(8)))

            # the QR takes the room the screen leaves: 340 px at 100%, smaller when it must be
            win.update_idletasks()
            room_h = sh - 2 * margin - frame.winfo_reqheight() - px(8)
            room_w = sw - 2 * margin - px(24)
            qr_side = int(min(px(255), room_h, room_w))
            qr = b64_photo(QR_BAY, qr_side, win) if (qr_side >= 80 and not wrapup) else None
            if qr:
                tile = tk.Label(frame, image=qr, bg="white", bd=0)
                tile.image = qr  # keep a reference or Tk garbage-collects it
                tile.pack(side="top", pady=(0, px(4)))

            win.update_idletasks()
            w = min(max(frame.winfo_reqwidth(), px(240)), sw - 2 * margin)
            h = min(frame.winfo_reqheight(), sh - 2 * margin)
            win.geometry(f"{w}x{h}+{margin}+{sh - h - margin}")

            # the red X: PLACED, not packed - always in the top-right corner, whatever the rest does
            xbtn = tk.Canvas(frame, width=xs, height=xs, bg=PANEL, highlightthickness=0, bd=0,
                             cursor="hand2")
            inset, line = max(8, xs // 5), max(4, xs // 9)
            xbtn.create_line(inset, inset, xs - inset, xs - inset, fill=CLOSE_RED, width=line,
                             capstyle="round")
            xbtn.create_line(xs - inset, inset, inset, xs - inset, fill=CLOSE_RED, width=line,
                             capstyle="round")
            xbtn.bind("<Button-1>", close)
            xbtn.place(relx=1.0, x=-px(3), y=px(3), anchor="ne")

            # Esc closes it once it has the keyboard; a click anywhere on it gives it the keyboard
            def take_keyboard(event=None):
                if state["closed"]:
                    return
                _no_activate(win, False)
                try:
                    win.focus_force()
                except Exception:
                    pass
            win.bind_all("<Button-1>", take_keyboard, add="+")
            win.bind_all("<Escape>", close)

            def count_down():
                if state["closed"]:
                    return
                left = state["left"]
                countdown.config(text=f"Closes in {left // 60}:{left % 60:02d}")
                _probe({"event": "countdown", "text": countdown.cget("text")})
                if left <= 0:
                    close()
                    return
                state["left"] = left - 1
                win.after(1000, count_down)

            def report():
                try:
                    def geo(wd):
                        return [wd.winfo_rootx(), wd.winfo_rooty(), wd.winfo_width(), wd.winfo_height()]
                    _probe({"event": "shown", "kind": "wrapup" if wrapup else "extend", "nextIn": nxt, "screen": [sw, sh], "scaling": scale, "win": geo(win),
                            "x": geo(xbtn), "close": geo(close_btn), "qr": qr_side if qr else 0,
                            "countdown": countdown.cget("text")})
                except Exception:
                    pass

            _no_activate(win, True)        # never takes the keyboard from the game on the way up
            win.deiconify()
            count_down()
            win.after(500, report)
            win.after((POPUP_SECS + 5) * 1000, close)   # the backstop, should the countdown ever stall
            win.mainloop()
        except Exception:
            pass
        finally:
            popup_window = None

    threading.Thread(target=run, daemon=True).start()


# ── WARNING MESSAGE (next group booked right after) ───────────────────────────
def show_wrapup_message(mins_left):
    """The next group is booked right after: the same bottom-left panel as the extend popup, no QR (they
    cannot extend), shown without taking the keyboard from the game, closed by the X, Close, or Esc once
    clicked, and on its own after POPUP_SECS (Oct 2026 - it was a Windows message box)."""
    show_extend_popup(mins_left, wrapup=True)


def hero_photo(w, h, master):
    """The facility's picture (the website's hero photo) filling a w x h screen: cropped to cover it
    and darkened so the panel in front reads. Needs Pillow (it is a JPEG); without it, or with no
    picture, None - and the reserved screen is plain, as it always was."""
    if not HERO_B64 or Image is None:
        return None
    try:
        from PIL import ImageEnhance
        img = Image.open(io.BytesIO(base64.b64decode(HERO_B64))).convert("RGB")
        scale = max(w / img.width, h / img.height)
        img = img.resize((max(1, int(img.width * scale + 0.5)), max(1, int(img.height * scale + 0.5))), Image.LANCZOS)
        left, top = (img.width - w) // 2, (img.height - h) // 2
        img = ImageEnhance.Brightness(img.crop((left, top, left + w, top + h))).enhance(0.55)
        return ImageTk.PhotoImage(img, master=master)
    except Exception:
        return None


# ── IDLE BLANK SCREENS ─────────────────────────────────────────────────────────
def show_blank_screens(next_start):
    """Fullscreen 'BAY RESERVED' window on every attached monitor.
    ITS WINDOWS ARE CLOSED ONLY BY THE THREAD THAT MADE THEM (Oct 2026, from pilot facility's 09-27 addendum):
    close_blank_screens() is called from the poll loop, and a Tk window destroyed from another thread
    is the pattern that froze pilot facility's watcher. So close_blank_screens() only sets this screen's stop
    signal, and the screen's own thread notices it within a fraction of a second and closes itself."""
    global blank_windows, _blank_stop
    if _blank_stop is not None and not _blank_stop.is_set():
        return  # already up, or on its way up
    stop = threading.Event()
    _blank_stop = stop

    def run():
        global blank_windows
        windows = []
        try:
            root = tk.Tk()
            windows.append(root)
            mons = get_monitors()

            photos = 0
            for i, (x, y, w, h) in enumerate(mons):
                win = root if i == 0 else tk.Toplevel(root)
                win.configure(bg=BG)
                win.overrideredirect(True)
                win.attributes("-topmost", True)
                win.geometry(f"{w}x{h}+{x}+{y}")

                # the facility's picture behind it all, and the words on a panel in front (Oct 2026);
                # with no picture the words sit on the screen itself, exactly as before
                host, top_pad = win, int(h * 0.10)
                pic = hero_photo(w, h, win)
                if pic:
                    bg_label = tk.Label(win, image=pic, bd=0)
                    bg_label.image = pic
                    bg_label.place(x=0, y=0, relwidth=1, relheight=1)
                    host, top_pad = tk.Frame(win, bg=BG, padx=48, pady=28), 0
                    host.place(relx=0.5, rely=0.5, anchor="center")
                    photos += 1

                logo = b64_photo(LOGO_B64, int(h * 0.14), win)
                if logo:
                    ll = tk.Label(host, image=logo, bg=BG)
                    ll.image = logo
                    ll.pack(pady=(top_pad, 6))
                else:
                    tk.Label(host, text=BUSINESS_NAME,
                             font=("Segoe UI", 26, "bold"), fg=TEXT,
                             bg=BG).pack(pady=(int(h * 0.12) if host is win else 0, 6))

                tk.Label(host, text="BAY RESERVED",
                         font=("Segoe UI", 40, "bold"), fg=TEXT, bg=BG).pack(pady=(8, 4))

                if next_start:
                    tk.Label(host, text=f"Next session begins at {next_start}",
                             font=("Segoe UI", 20), fg=ACCENT, bg=BG).pack(pady=(0, 14))

                tk.Label(host, text="Scan to book your session",
                         font=("Segoe UI", 16), fg=MUTED, bg=BG).pack(pady=(10, 10))

                qr_px = max(160, int(h * 0.18))
                qr = b64_photo(QR_GENERIC, qr_px, win)
                if qr:
                    tile = tk.Label(host, image=qr, bg="white", bd=0)
                    tile.image = qr
                    tile.pack()

                tk.Label(host, text=SITE_URL, font=("Segoe UI", 14),
                         fg=ACCENT, bg=BG).pack(pady=(12, 0))

                # Staff kill code on every window. A window in the background never has the keyboard
                # on its own, so a click on the screen gives it the keyboard (as the popup does); on
                # Windows the same keys also work with no click at all (_staff_hotkey, below).
                win.bind("<Control-Shift-F12>", kill_blank)
                win.bind("<Button-1>", lambda event, w=win: _take_keyboard(w), add="+")

            def watch_stop():
                if stop.is_set():
                    try:
                        root.destroy()
                    except Exception:
                        pass
                    return
                root.after(150, watch_stop)

            root.after(150, watch_stop)
            blank_windows = windows
            _probe({"event": "blank-shown", "next": next_start, "windows": len(mons), "photos": photos})
            root.mainloop()
        except Exception:
            pass
        finally:
            stop.set()
            if blank_windows is windows:
                blank_windows = []
            _probe({"event": "blank-closed"})

    threading.Thread(target=run, daemon=True).start()


def _take_keyboard(win):
    try:
        win.focus_force()
    except Exception:
        pass


def close_blank_screens():
    """Close the reserved screen (session starting or staff override). It only ASKS: the screen's
    own thread closes its windows (see show_blank_screens). Safe from any thread."""
    global blank_windows, _blank_stop
    stop, _blank_stop = _blank_stop, None
    blank_windows = []
    if stop is not None:
        stop.set()


def kill_blank(event=None):
    """Staff kill code: unblank and STAY unblanked until the next real session.
    The 'global' declaration below is load-bearing - without it Python creates
    a local variable, the flag never sets, and the override silently fails."""
    global admin_override
    admin_override = True
    close_blank_screens()


def _staff_hotkey():
    """Windows: Ctrl+Shift+F12 works anywhere on the PC, no click first (Oct 2026, from pilot facility's 09-27
    addendum). The reserved screen's own key binding only hears keys while it has the keyboard, and a
    program in the background never gets it on its own. A hotkey another program already holds is left
    to it - the click-then-keys path on the screen still works."""
    if not sys.platform.startswith("win"):
        return
    try:
        from ctypes import wintypes
        u = ctypes.windll.user32
        MOD_CONTROL, MOD_SHIFT, MOD_NOREPEAT, VK_F12, WM_HOTKEY = 0x0002, 0x0004, 0x4000, 0x7B, 0x0312
        if not u.RegisterHotKey(None, 0x4246, MOD_CONTROL | MOD_SHIFT | MOD_NOREPEAT, VK_F12):
            return
        msg = wintypes.MSG()
        while u.GetMessageW(ctypes.byref(msg), None, 0, 0) > 0:
            if msg.message == WM_HOTKEY:
                kill_blank()
    except Exception:
        pass


# ── ROUTINES: WATCH ME, THEN DO IT FOR ME (Oct 21 2026) ─────────
# maintainer: "say, hey, watch what I'm gonna do on Bay 2. And then the AI will watch what they're doing ... and then I want it to
# start on windows startup, or ... when this program opens ... if it sees the unicorn [sign-in], they could sign in ...
# build a bay watcher that if the ... gs pro connector, if the players close it, then it ... closes and reopens stuff".
# The owner starts teaching from the routines card or the assistant. This watcher puts a bar across the top and records
# each click - the window it landed in, where in it, the words under it (Windows' own text reader) and a small picture -
# and Enter, Tab, Esc, the arrows and the F-keys. Never the letters typed, so never a password: a password is typed once
# into this watcher's own box (Ctrl+Shift+F9 while teaching), kept on this PC under Windows' own protection, and typed
# from there. A program opened while teaching becomes an "open" step, and only a program taught on THIS PC is ever opened
# or closed by a routine (TAUGHT_FILE) - the unit cannot add one. The unit keeps the steps (services/routines.js); this
# watcher runs them when the unit asks (the staff pad, a session starting) or on its own triggers: a hotkey, Windows
# starting, a program opening or closing, a window appearing. Each trigger fires at most once a minute and five times an
# hour, so a program that keeps closing is not reopened for ever. Nothing here runs without a bay key ("" - no routines).
BAY_KEY = str(_config.get("bayKey") or "")
_HERE = os.path.dirname(os.path.abspath(__file__))
TAUGHT_FILE = os.path.join(_HERE, "taught-programs.json")
SECRETS_FILE = os.path.join(_HERE, "routine-passwords.json")
ROUTINE_POLL = 10                  # seconds between the routines poll and the look at this PC's triggers
ROUTINES_CACHE = os.path.join(_HERE, "routines-cache.json")   # the last routines the unit sent: triggers work while it is away
SHELL_PROGRAMS = ("explorer.exe", "startmenuexperiencehost.exe", "searchhost.exe", "searchapp.exe", "shellexperiencehost.exe")
_KEY_VK = {"enter": 0x0D, "tab": 0x09, "esc": 0x1B, "space": 0x20, "backspace": 0x08, "delete": 0x2E, "up": 0x26, "down": 0x28,
           "left": 0x25, "right": 0x27, "home": 0x24, "end": 0x23, "pageup": 0x21, "pagedown": 0x22,
           "ctrl": 0x11, "alt": 0x12, "shift": 0x10, "win": 0x5B}
for _i in range(1, 13):
    _KEY_VK["f%d" % _i] = 0x6F + _i
_EXTENDED = (0x2E, 0x26, 0x28, 0x25, 0x27, 0x24, 0x23, 0x21, 0x22, 0x5B)
_VK_NAME = dict((v, k) for k, v in _KEY_VK.items() if k not in ("ctrl", "alt", "shift", "win"))


def _base(p):
    """A Windows path's file name, on any machine."""
    return str(p or "").replace("/", "\\").split("\\")[-1]


def key_vks(keys):
    """"ctrl+s" -> [VK_CONTROL, ord("S")]; a key this watcher does not know raises ValueError."""
    out = []
    for part in str(keys or "").lower().split("+"):
        if part in _KEY_VK:
            out.append(_KEY_VK[part])
        elif len(part) == 1 and (part.isalpha() or part.isdigit()):
            out.append(ord(part.upper()))
        else:
            raise ValueError("not a key a routine presses: %r" % part)
    return out


def screen_point(rect, fx, fy):
    """A place in a window, as fractions of it, to a point on the screen."""
    l, t, r, b = rect
    return int(round(l + (r - l) * float(fx))), int(round(t + (b - t) * float(fy)))


def match_window(windows, title):
    """The window a step means: the same title, else one that starts like it, else one that holds it."""
    want = str(title or "").strip().lower()
    if not want:
        return None
    for test in (lambda t: t == want, lambda t: t.startswith(want[:24]), lambda t: want in t):
        for w in windows:
            if test(str(w.get("title") or "").strip().lower()):
                return w
    return None


def steps_from_events(events, running_at_start):
    """What the owner did, as steps (the unit checks them again; services/routines.js checkSteps).
    events: dicts in time order - {t, kind: 'click', x, y, button, title, rect, program, label, look}, {t, kind: 'key',
    keys} or {t, kind: 'secret', name}. A click on the desktop, the taskbar or the Start menu is how a program was opened,
    not a step; the first click in a program that was not running when teaching began opens it and waits for its window."""
    steps, opened = [], set()
    running = set(str(p).lower() for p in running_at_start)
    last_t, prev = None, None
    for e in events:
        gap = (e["t"] - last_t) if last_t is not None else 0.0
        kind = e.get("kind")
        if kind == "click":
            prog = str(e.get("program") or "")
            if _base(prog).lower() in SHELL_PROGRAMS:
                last_t = e["t"]
                prev = None
                continue
            if prog and prog.lower() not in running and prog.lower() not in opened:
                opened.add(prog.lower())
                steps.append({"do": "open", "program": prog})
                steps.append({"do": "wait_window", "title": str(e.get("title") or _base(prog)), "seconds": 60})
                gap = 0.0
            # the second click of a double-click: the same button, within four pixels and half a second
            if (prev is not None and steps and steps[-1].get("do") == "click" and e.get("button") == prev.get("button")
                    and abs(e["x"] - prev["x"]) <= 4 and abs(e["y"] - prev["y"]) <= 4 and e["t"] - prev["t"] <= 0.5):
                steps[-1]["double"] = True
                prev = None
                last_t = e["t"]
                continue
            if gap >= 1.5:
                steps.append({"do": "wait", "seconds": round(min(gap, 15.0), 1)})
            l, t, r, b = e["rect"]
            w, h = max(1, r - l), max(1, b - t)
            step = {"do": "click", "window": str(e.get("title") or _base(prog) or "the screen"),
                    "x": round(min(1.0, max(0.0, (e["x"] - l) / float(w))), 4),
                    "y": round(min(1.0, max(0.0, (e["y"] - t) / float(h))), 4), "button": e.get("button") or "left"}
            if e.get("label"):
                step["label"] = str(e["label"])[:60]
            if e.get("look"):
                step["look"] = e["look"]
            steps.append(step)
            prev = e
        elif kind == "key":
            if gap >= 1.5:
                steps.append({"do": "wait", "seconds": round(min(gap, 15.0), 1)})
            steps.append({"do": "key", "keys": e["keys"]})
            prev = None
        elif kind == "secret":
            steps.append({"do": "type_secret", "name": e["name"]})
            prev = None
        last_t = e["t"]
    return steps


class RoutineRunner:
    """Runs a routine's steps through `osx` (the Windows side below; a stand-in in the battery). Stops at the first step
    that cannot be done and says why - it never carries on past a step it could not do (rule 29)."""

    def __init__(self, osx, taught, secrets, sleep=time.sleep, now=time.time):
        self.osx, self.taught, self.secrets, self.sleep, self.now = osx, taught, secrets, sleep, now

    def run(self, steps):
        for n, s in enumerate(steps, 1):
            try:
                ok, why = self._step(s)
            except Exception as e:  # a step that broke is a step not done
                ok, why = False, "%s: %s" % (type(e).__name__, e)
            if not ok:
                return False, n, why
        return True, None, "all %d steps done" % len(steps)

    def _window(self, title, seconds):
        end = self.now() + seconds
        while True:
            w = match_window(self.osx.windows(), title)
            if w is not None or self.now() >= end:
                return w
            self.sleep(0.5)

    def _resolve(self, p):
        """The program a step names, as this PC was shown it: its full path, or - for a routine made from words, or copied
        from a bay whose PC keeps it in another folder - its file name alone, matched to the one shown on THIS PC. None when
        this PC was never shown it (Oct 21 2026, night: a close by name matched nothing and still said it was done)."""
        taught = self.taught()
        if p.lower() in taught:
            return p
        same = sorted(t for t in taught if _base(t).lower() == _base(p).lower())
        return same[0] if same else None

    def _step(self, s):
        d = s.get("do")
        if d == "open":
            p = self._resolve(str(s.get("program") or ""))
            if p is None:
                return False, "%s was not taught on this PC, so a routine does not open it" % _base(s.get("program"))
            # "Open GSPro" means GSPro is open: already running (the session before left it up), its window is brought
            # forward and no second copy is started (Oct 21 2026, night - a second copy is refused by most simulators)
            want = p.lower()
            pids = [pid for pid, q in self.osx.processes().items() if str(q).lower() == want]
            if pids:
                w = next((x for x in self.osx.windows() if x.get("pid") in pids), None)
                if w is not None:
                    self.osx.focus(w)
                return True, ""
            self.osx.open(p, str(s.get("args") or ""))
            return True, ""
        if d == "wait_window":
            if self._window(s.get("title"), float(s.get("seconds", 30))) is None:
                return False, "the \"%s\" window did not appear within %s seconds" % (s.get("title"), s.get("seconds", 30))
            return True, ""
        if d == "click":
            w = self._window(s.get("window"), 5)
            if w is None:
                return False, "no \"%s\" window is on the screen" % s.get("window")
            self.osx.focus(w)
            if s.get("by") == "words":
                end = self.now() + float(s.get("wait", 30))
                while True:
                    hit = self.osx.find_text(w, s.get("label"))
                    if hit:
                        x, y = hit
                        break
                    if self.osx.reader() is False:
                        return False, "this PC cannot read words on its screen - click \"%s\" by its spot instead" % s.get("label")
                    if self.now() >= end:
                        return False, "\"%s\" did not show in %s within %s seconds" % (s.get("label"), s.get("window"), s.get("wait", 30))
                    self.sleep(1)
                    w = match_window(self.osx.windows(), s.get("window")) or w
            else:
                x, y = screen_point(w["rect"], s.get("x", 0.5), s.get("y", 0.5))
            self.osx.click(x, y, s.get("button") or "left", bool(s.get("double")))
            return True, ""
        if d == "key":
            self.osx.keys(key_vks(s.get("keys")))
            return True, ""
        if d == "type":
            self.osx.type_text(str(s.get("text") or ""))
            return True, ""
        if d == "type_secret":
            v = self.secrets.get(s.get("name"))
            if v is None:
                return False, "no password is kept on this PC as \"%s\" - type it into the box this PC shows, then run it again" % s.get("name")
            self.osx.type_text(v)
            return True, ""
        if d == "wait":
            self.sleep(float(s.get("seconds", 1)))
            return True, ""
        if d == "close":
            p = self._resolve(str(s.get("program") or ""))
            if p is None:
                return False, "%s was not taught on this PC, so a routine does not close it" % _base(s.get("program"))
            self.osx.close(p, float(s.get("seconds", 10)))
            return True, ""
        return False, "\"%s\" is not a step this watcher knows - download its package again" % d


class TriggerGate:
    """A trigger on this PC fires once each time it happens, at most once a minute and five times an hour (a program that
    keeps closing is not reopened for ever). fire() -> 'run', 'wait' (too soon) or 'stop' (the hour's five are used)."""

    def __init__(self, now=time.time):
        self.now, self.fired = now, {}

    def fire(self, key):
        t = self.now()
        past = [x for x in self.fired.get(key, []) if t - x < 3600]
        if past and t - past[-1] < 60:
            return "wait"
        if len(past) >= 5:
            self.fired[key] = past
            return "stop"
        past.append(t)
        self.fired[key] = past
        return "run"


def _load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def _save_json(path, data):
    try:
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.replace(tmp, path)
    except Exception:
        pass


def taught_programs():
    return set(str(p).lower() for p in _load_json(TAUGHT_FILE, []))


def teach_program(path):
    have = _load_json(TAUGHT_FILE, [])
    if str(path).lower() not in (str(p).lower() for p in have):
        have.append(str(path))
        _save_json(TAUGHT_FILE, have)


class _Secrets:
    """Passwords a routine types, kept on this PC only, each under Windows' own protection for this Windows account
    (CryptProtectData). Never sent to the unit, never in a routine, never in a recording."""

    def get(self, name):
        blob = _load_json(SECRETS_FILE, {}).get(str(name))
        if not blob:
            return None
        try:
            return _dpapi(base64.b64decode(blob), protect=False).decode("utf-8")
        except Exception:
            return None

    def set(self, name, value):
        data = _load_json(SECRETS_FILE, {})
        data[str(name)] = base64.b64encode(_dpapi(value.encode("utf-8"), protect=True)).decode("ascii")
        _save_json(SECRETS_FILE, data)


def _dpapi(data, protect):
    from ctypes import wintypes

    class BLOB(ctypes.Structure):
        _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_char))]
    buf = ctypes.create_string_buffer(data, len(data))
    src, out = BLOB(len(data), ctypes.cast(buf, ctypes.POINTER(ctypes.c_char))), BLOB()
    fn = ctypes.windll.crypt32.CryptProtectData if protect else ctypes.windll.crypt32.CryptUnprotectData
    if not fn(ctypes.byref(src), None, None, None, None, 0x1, ctypes.byref(out)):   # CRYPTPROTECT_UI_FORBIDDEN
        raise OSError("Windows would not %s it" % ("protect" if protect else "unprotect"))
    try:
        return ctypes.string_at(out.pbData, out.cbData)
    finally:
        ctypes.windll.kernel32.LocalFree(out.pbData)


# ── WINDOWS' OWN TEXT READER (Windows.Media.Ocr) ──────────────────────────────
# Microsoft's API (learn.microsoft.com, Windows.Media.Ocr.OcrEngine.RecognizeAsync(SoftwareBitmap) -> OcrResult, whose Lines
# hold Words, each with Text and BoundingRect), through Python's WinRT projection: the older `winsdk` package or the newer
# `winrt` ones, names in snake_case. The bitmap is built from RGBA8 bytes through a DataWriter
# (SoftwareBitmap.create_copy_from_buffer), as a working project does it (huggingface.co dlxjj/comicocr ocr_windows.py).
# Proven on Linux only through the battery's stand-in; on a real bay PC it is first proven at the bench - until then a PC
# whose reader does not load says so, and a click by its words fails with that reason rather than guessing.
_OCR = None


def _ocr_load():
    global _OCR
    if _OCR is not None:
        return _OCR or None
    _OCR = False
    for pkg in ("winsdk", "winrt"):
        try:
            ocr = __import__(pkg + ".windows.media.ocr", fromlist=["OcrEngine"])
            img = __import__(pkg + ".windows.graphics.imaging", fromlist=["SoftwareBitmap"])
            st = __import__(pkg + ".windows.storage.streams", fromlist=["DataWriter"])
            eng = ocr.OcrEngine.try_create_from_user_profile_languages()
            if eng is not None:
                _OCR = (eng, img, st)
                return _OCR
        except Exception:
            continue
    return None


def ocr_words(pil_img):
    """[(text, (left, top, right, bottom))] for every word Windows reads in the picture; [] when it cannot read."""
    got = _ocr_load()
    if not got or pil_img is None:
        return []
    import asyncio
    eng, img, st = got
    try:
        rgba = pil_img.convert("RGBA")
        w, h = rgba.size
        dw = st.DataWriter()
        dw.write_bytes(rgba.tobytes())
        bmp = img.SoftwareBitmap.create_copy_from_buffer(dw.detach_buffer(), img.BitmapPixelFormat.RGBA8, w, h)

        async def go():
            return await eng.recognize_async(bmp)
        res = asyncio.run(go())
        out = []
        for line in res.lines:
            for word in line.words:
                r = word.bounding_rect
                out.append((str(word.text), (int(r.x), int(r.y), int(r.x + r.width), int(r.y + r.height))))
        return out
    except Exception:
        return []


def words_at(words, x, y, reach=60):
    """The words of the line nearest a point (a button's label): the word under the point, with its neighbours on the
    same line that sit close to it."""
    if not words:
        return ""
    def dist(r):
        l, t, rr, b = r
        dx = 0 if l <= x <= rr else min(abs(x - l), abs(x - rr))
        dy = 0 if t <= y <= b else min(abs(y - t), abs(y - b))
        return dx + dy
    best = min(words, key=lambda wd: dist(wd[1]))
    if dist(best[1]) > reach:
        return ""
    l, t, r, b = best[1]
    line = sorted([wd for wd in words if abs(((wd[1][1] + wd[1][3]) / 2.0) - ((t + b) / 2.0)) < max(6, (b - t) * 0.6)], key=lambda wd: wd[1][0])
    # the run of words around the hit with no wide gap between them
    i = line.index(best) if best in line else 0
    lo = hi = i
    while lo > 0 and line[lo][1][0] - line[lo - 1][1][2] < (b - t) * 1.2:
        lo -= 1
    while hi < len(line) - 1 and line[hi + 1][1][0] - line[hi][1][2] < (b - t) * 1.2:
        hi += 1
    return " ".join(wd[0] for wd in line[lo:hi + 1])[:60]


def find_words(words, label):
    """Where a label's words are, as the middle of the run that spells it (any case), or None."""
    want = [w for w in str(label or "").lower().split() if w]
    if not want or not words:
        return None
    toks = [(wd[0].lower().strip(".,:;!?\"'()"), wd[1]) for wd in words]
    for i in range(len(toks) - len(want) + 1):
        if all(toks[i + k][0] == want[k] for k in range(len(want))):
            rs = [toks[i + k][1] for k in range(len(want))]
            return (int((min(r[0] for r in rs) + max(r[2] for r in rs)) / 2), int((min(r[1] for r in rs) + max(r[3] for r in rs)) / 2))
    return None


class _WinOS:
    """What a routine does to this PC, through Windows itself (user32, kernel32, psapi). Only on Windows."""

    def __init__(self):
        from ctypes import wintypes
        self.w, self.u, self.k = wintypes, ctypes.windll.user32, ctypes.windll.kernel32

    def windows(self):
        out, w, u = [], self.w, self.u
        proto = ctypes.WINFUNCTYPE(ctypes.c_bool, w.HWND, w.LPARAM)

        def each(hwnd, _):
            if u.IsWindowVisible(hwnd):
                n = u.GetWindowTextLengthW(hwnd)
                if n:
                    buf = ctypes.create_unicode_buffer(n + 1)
                    u.GetWindowTextW(hwnd, buf, n + 1)
                    rc = w.RECT()
                    u.GetWindowRect(hwnd, ctypes.byref(rc))
                    pid = w.DWORD()
                    u.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
                    out.append({"hwnd": hwnd, "title": buf.value, "rect": (rc.left, rc.top, rc.right, rc.bottom), "pid": pid.value})
            return True
        u.EnumWindows(proto(each), 0)
        return out

    def program_of(self, pid):
        h = self.k.OpenProcess(0x1000, False, pid)   # PROCESS_QUERY_LIMITED_INFORMATION
        if not h:
            return ""
        try:
            buf, n = ctypes.create_unicode_buffer(1024), self.w.DWORD(1024)
            return buf.value if self.k.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(n)) else ""
        finally:
            self.k.CloseHandle(h)

    def processes(self):
        """{pid: program path} for everything running."""
        arr = (self.w.DWORD * 4096)()
        got = self.w.DWORD()
        if not ctypes.windll.psapi.EnumProcesses(ctypes.byref(arr), ctypes.sizeof(arr), ctypes.byref(got)):
            return {}
        out = {}
        for pid in arr[:got.value // ctypes.sizeof(self.w.DWORD)]:
            if pid:
                p = self.program_of(pid)
                if p:
                    out[pid] = p
        return out

    def open(self, program, args=""):
        cmd = '"%s" %s' % (program, args) if args else [program]
        subprocess.Popen(cmd, cwd=os.path.dirname(program) or None, close_fds=True)

    def close(self, program, seconds=10):
        want = str(program).lower()
        pids = [pid for pid, p in self.processes().items() if p.lower() == want]
        for win in self.windows():
            if win["pid"] in pids:
                self.u.PostMessageW(win["hwnd"], 0x0010, 0, 0)   # WM_CLOSE: asked first
        end = time.time() + seconds
        while time.time() < end and any(p.lower() == want for p in self.processes().values()):
            time.sleep(0.5)
        for pid, p in self.processes().items():
            if p.lower() == want:
                subprocess.call(["taskkill", "/PID", str(pid), "/T", "/F"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def focus(self, win):
        hwnd = win["hwnd"]
        if self.u.IsIconic(hwnd):
            self.u.ShowWindow(hwnd, 9)                       # SW_RESTORE
        self.u.keybd_event(0x12, 0, 0, 0)                    # an Alt press lets a background program bring a window up
        self.u.keybd_event(0x12, 0, 2, 0)
        self.u.SetForegroundWindow(hwnd)
        time.sleep(0.2)

    def click(self, x, y, button="left", double=False):
        down, up = (0x0008, 0x0010) if button == "right" else (0x0002, 0x0004)
        self.u.SetCursorPos(int(x), int(y))
        for _ in range(2 if double else 1):
            self.u.mouse_event(down, 0, 0, 0, 0)
            self.u.mouse_event(up, 0, 0, 0, 0)
            time.sleep(0.08)

    def keys(self, vks):
        flag = lambda vk: 0x1 if vk in _EXTENDED else 0
        for vk in vks:
            self.u.keybd_event(vk, 0, flag(vk), 0)
        for vk in reversed(vks):
            self.u.keybd_event(vk, 0, flag(vk) | 0x2, 0)

    def type_text(self, text):
        w = self.w

        class KEYBDINPUT(ctypes.Structure):
            _fields_ = [("wVk", w.WORD), ("wScan", w.WORD), ("dwFlags", w.DWORD), ("time", w.DWORD), ("dwExtraInfo", ctypes.c_size_t)]

        class _U(ctypes.Union):
            _fields_ = [("ki", KEYBDINPUT), ("pad", ctypes.c_byte * 32)]

        class INPUT(ctypes.Structure):
            _fields_ = [("type", w.DWORD), ("u", _U)]
        for ch in str(text):
            for fl in (0x0004, 0x0004 | 0x0002):              # KEYEVENTF_UNICODE, then its key-up
                inp = INPUT(1, _U(ki=KEYBDINPUT(0, ord(ch), fl, 0, 0)))
                self.u.SendInput(1, ctypes.byref(inp), ctypes.sizeof(INPUT))
            time.sleep(0.01)

    def grab(self, rect):
        try:
            from PIL import ImageGrab
            return ImageGrab.grab(bbox=tuple(int(v) for v in rect), all_screens=True)
        except Exception:
            return None

    def reader(self):
        return bool(_ocr_load())

    def find_text(self, win, label):
        l, t, r, b = win["rect"]
        hit = find_words(ocr_words(self.grab((l, t, r, b))), label)
        return (l + hit[0], t + hit[1]) if hit else None


def _look_at(osx, x, y):
    """The words under a click and a small picture of it, while teaching: (label, base64 JPEG)."""
    label, look = "", ""
    try:
        img = osx.grab((x - 200, y - 60, x + 200, y + 60))
        if img is not None:
            label = words_at(ocr_words(img), 200, 60)
            crop = img.crop((120, 30, 280, 90)).convert("RGB")
            buf = io.BytesIO()
            crop.save(buf, "JPEG", quality=55)
            look = base64.b64encode(buf.getvalue()).decode("ascii")
            if len(look) > 15000:
                look = ""
    except Exception:
        pass
    return label, look


# ── TALKING TO THE UNIT ABOUT ROUTINES ─────────────────────────────────────────
def _poll_params():
    """The poll's question: this bay, and the programs this PC was shown (their file names only - the unit tells the owner
    which bay's PC still has to be shown a program a copied routine opens; it can never add one to this list)."""
    names = sorted(set(_base(p) for p in _load_json(TAUGHT_FILE, [])), key=lambda n: n.lower())[:60]   # as they were taught
    return {"bay": BAY_ID, "taught": ",".join(names)[:3900]}


def _routines_call(method, sub, body=None):
    """The unit's routines routes, with this bay's key. None when it does not answer."""
    if not BAY_KEY:
        return None
    for base in (SERVER_URL, FALLBACK_URL):
        if not base:
            continue
        url = base + "/api/session/routines" + sub
        try:
            if requests is not None:
                if method == "GET":
                    r = requests.get(url, params=_poll_params(), headers={"x-bay-key": BAY_KEY}, timeout=10)
                else:
                    r = requests.post(url, json=dict(body or {}, bay=BAY_ID), headers={"x-bay-key": BAY_KEY}, timeout=15)
                return r.json()
            import urllib.parse
            import urllib.request
            if method == "GET":
                req = urllib.request.Request(url + "?" + urllib.parse.urlencode(_poll_params()), headers={"x-bay-key": BAY_KEY})
            else:
                req = urllib.request.Request(url, data=json.dumps(dict(body or {}, bay=BAY_ID)).encode("utf-8"),
                                             headers={"x-bay-key": BAY_KEY, "Content-Type": "application/json"}, method="POST")
            with urllib.request.urlopen(req, timeout=15) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except Exception:
            continue
    return None


class RoutineHost:
    """The routines side of the watcher: the poll, the runs the unit asks for, the triggers on this PC, and the results
    sent back (kept until the unit has them). Everything that touches Windows goes through `osx`."""

    def __init__(self, osx, call=_routines_call, now=time.time, sleep=time.sleep):
        self.osx, self.call, self.now, self.sleep = osx, call, now, sleep
        self.routines, self.pending, self.gate = _load_json(ROUTINES_CACHE, []), [], TriggerGate(now)
        self.runner = RoutineRunner(osx, taught_programs, _Secrets(), sleep=sleep, now=now)
        self.lock, self.plock = threading.Lock(), threading.Lock()
        self.seen_programs, self.seen_windows, self.started = None, None, False
        self.teaching, self.taught_ids, self.stopped = None, set(), set()

    def report(self, result):
        with self.plock:
            self.pending.append(result)
        self.flush()

    def flush(self):
        with self.plock:
            todo, self.pending = self.pending, []
        keep = []
        for r in todo:
            got = self.call("POST", "/result", r)
            if not (got and (got.get("ok") or got.get("already") or got.get("error"))):
                keep.append(r)                  # the unit did not answer: sent again on the next poll
        with self.plock:
            self.pending = keep + self.pending

    def run_routine(self, routine, run_id=None, source=None):
        """One routine, one at a time on this PC; the result goes back to the unit either way."""
        with self.lock:
            ok, step, why = self.runner.run(routine.get("steps") or [])
        res = {"ok": ok, "failed_step": step, "detail": why}
        if run_id:
            res["run_id"] = run_id
        else:
            res.update({"routine_id": routine.get("id"), "source": source})
        self.report(res)
        return ok, step, why

    def poll_once(self):
        """Ask the unit, start teaching if it asks, run what it asks, and look at this PC's triggers."""
        got = self.call("GET", "", None)
        if got and got.get("ok"):
            self.routines = got.get("routines") or []
            _save_json(ROUTINES_CACHE, self.routines)
            # a teaching is started once: one this PC finished or stopped is never started again
            if got.get("teach") and self.teaching is None and got["teach"].get("id") not in self.taught_ids:
                self.start_teaching(got["teach"])
            run = got.get("run")
            if run:
                r = next((x for x in self.routines if x.get("id") == run.get("routine_id")), None)
                if r is None:
                    self.report({"run_id": run.get("id"), "ok": False, "detail": "this PC was not told that routine's steps"})
                else:
                    self.run_routine(r, run_id=run.get("id"))
        self.flush()
        self.look_for_triggers()
        return got

    def fire(self, routine, source):
        key = "%s:%s" % (routine.get("id"), source)
        g = self.gate.fire(key)
        if g == "run":
            self.stopped.discard(key)
            return self.run_routine(routine, source=source)
        if g == "stop" and key not in self.stopped:
            self.stopped.add(key)
            self.report({"routine_id": routine.get("id"), "source": "limit", "ok": False,
                         "detail": "it was started five times within an hour by %s - stopped until the hour is up" % source.replace("_", " ")})
        return None

    def look_for_triggers(self):
        """Windows starting (once), a program opening or closing, a window appearing - each when it happens."""
        try:
            progs = set(_base(p).lower() for p in self.osx.processes().values())
            titles = [str(w.get("title") or "").lower() for w in self.osx.windows()]
        except Exception:
            return
        first = self.seen_programs is None
        for r in self.routines:
            t = r.get("triggers") or {}
            if t.get("startup") and not self.started:
                self.fire(r, "startup")
            if not first:
                ps = str(t.get("program_starts") or "").lower()
                if ps and ps in progs and ps not in self.seen_programs:
                    self.fire(r, "program_starts")
                pe = str(t.get("program_stops") or "").lower()
                if pe and pe in self.seen_programs and pe not in progs:
                    self.fire(r, "program_stops")
            wa = str(t.get("window_appears") or "").lower()
            if wa:
                now_there = any(wa in x for x in titles)
                was_there = bool(self.seen_windows) and any(wa in x for x in self.seen_windows)
                if now_there and not was_there:
                    self.fire(r, "window_appears")
        self.started = True
        self.seen_programs, self.seen_windows = progs, titles

    def start_teaching(self, teach):
        self.teaching = teach
        self.taught_ids.add(teach.get("id"))
        threading.Thread(target=self._teach, args=(teach,), daemon=True).start()

    def _teach(self, teach):
        t = None
        try:
            t = _Teacher(self.osx, teach)
            steps = t.record()
            if not steps:
                # stopped, or nothing done: the unit is told, so it stops waiting and is never asked again
                self.call("POST", "/recording", {"teach_id": teach.get("id"), "cancelled": True})
                t.say("Stopped - nothing was kept")
            else:
                for s in steps:
                    if s.get("do") == "open":
                        teach_program(s["program"])
                got = self.call("POST", "/recording", {"teach_id": teach.get("id"), "steps": steps})
                # the unit's own last words when it sends some (a program shown to this PC: "Taught on this PC: GSPro")
                t.say(str(got.get("say")) if got and got.get("ok") and got.get("say") else
                      ("Sent: %d steps - name it and say when it runs in the assistant" % (got or {}).get("steps", len(steps)))
                      if got and got.get("ok") else "Not kept: %s" % ((got or {}).get("error") or "the booking system did not answer"))
        except Exception:
            pass
        finally:
            if t is not None:
                t.closed.set()
            self.teaching = None


class _Teacher:
    """Teaching, on Windows: a bar across the top, the mouse and keyboard watched until Ctrl+Shift+F11 (finish) or
    Ctrl+Shift+F10 (stop, nothing kept); Ctrl+Shift+F9 asks for a password in the watcher's own box and types it."""

    def __init__(self, osx, teach):
        self.osx, self.teach, self.events = osx, teach, []
        self.done, self.closed = threading.Event(), threading.Event()
        self.cancelled, self.asking, self.own = False, False, set()
        self.text = ('Teaching "%s" - click through as you always do.   Ctrl+Shift+F11 finish   Ctrl+Shift+F10 stop   '
                     'Ctrl+Shift+F9 type a password (kept on this PC)   Letters you type are never recorded' % teach.get("name", ""))
        if teach.get("program"):
            # only showing this PC a program (a routine copied from another bay opens it): what to do, said plainly
            self.text = ('Showing this PC %s: close it if it is open, open it once, then press Ctrl+Shift+F11.   '
                         'Ctrl+Shift+F10 stop' % teach.get("program"))

    def say(self, text):
        """A last word on the bar (read by the bar's own thread - Tk is never touched from here), then the bar goes."""
        self.text = text
        time.sleep(4)
        self.closed.set()

    def record(self):
        if not sys.platform.startswith("win"):
            return None
        self.running_at_start = set(self.osx.processes().values())
        threading.Thread(target=self._bar, daemon=True).start()
        threading.Thread(target=self._hooks, daemon=True).start()
        self.done.wait(timeout=30 * 60)
        if self.cancelled or not self.events:
            return None
        return steps_from_events(self.events, self.running_at_start)

    def _bar(self):
        try:
            root = tk.Tk()
            root.overrideredirect(True)
            root.attributes("-topmost", True)
            sw = root.winfo_screenwidth()
            root.geometry("%dx34+0+0" % sw)
            root.configure(bg="#0b2a4a")
            var = tk.StringVar(value=self.text)
            tk.Label(root, textvariable=var, bg="#0b2a4a", fg="white", font=("Segoe UI", 11)).pack(fill="both", expand=True)
            root.update()
            self.own.add(int(root.winfo_id()))
            try:
                self.own.add(int(ctypes.windll.user32.GetParent(root.winfo_id())))
            except Exception:
                pass
            _no_activate(root, True)
            shown = self.text
            while not self.closed.wait(0.05):
                if self.text != shown:
                    shown = self.text
                    var.set(shown)
                root.update()
            root.destroy()
        except Exception:
            pass

    def _ask_password(self):
        """The watcher's own box: a name and the password, masked; typed into the program now and kept on this PC."""
        out = {}
        try:
            win = tk.Tk()
            win.title("A password for this routine")
            win.attributes("-topmost", True)
            tk.Label(win, text="Kept on this PC only, under Windows' own protection. The routine types it from here.", padx=14, pady=8).pack()
            name = tk.Entry(win, width=34)
            name.insert(0, "Sign-in password")
            name.pack(padx=14, pady=4)
            pw = tk.Entry(win, width=34, show="*")
            pw.pack(padx=14, pady=4)
            pw.focus_set()

            def ok(event=None):
                out["name"], out["value"] = name.get().strip()[:40], pw.get()
                win.destroy()
            tk.Button(win, text="Keep it and type it", command=ok).pack(pady=10)
            win.bind("<Return>", ok)
            win.mainloop()
        except Exception:
            return None
        return out if out.get("name") and out.get("value") else None

    def _hooks(self):
        from ctypes import wintypes
        u, k = ctypes.windll.user32, ctypes.windll.kernel32
        WH_MOUSE_LL, WH_KEYBOARD_LL, HC_ACTION = 14, 13, 0
        WM_LBUTTONDOWN, WM_RBUTTONDOWN, WM_KEYDOWN, WM_SYSKEYDOWN, WM_HOTKEY = 0x0201, 0x0204, 0x0100, 0x0104, 0x0312

        class MSLL(ctypes.Structure):
            _fields_ = [("x", wintypes.LONG), ("y", wintypes.LONG), ("mouseData", wintypes.DWORD), ("flags", wintypes.DWORD),
                        ("time", wintypes.DWORD), ("extra", ctypes.c_size_t)]

        class KBLL(ctypes.Structure):
            _fields_ = [("vk", wintypes.DWORD), ("scan", wintypes.DWORD), ("flags", wintypes.DWORD), ("time", wintypes.DWORD), ("extra", ctypes.c_size_t)]
        HOOK = ctypes.WINFUNCTYPE(ctypes.c_long, ctypes.c_int, wintypes.WPARAM, wintypes.LPARAM)
        clicks = []

        def on_mouse(n, wp, lp):
            if n == HC_ACTION and wp in (WM_LBUTTONDOWN, WM_RBUTTONDOWN) and not self.asking:
                m = ctypes.cast(lp, ctypes.POINTER(MSLL)).contents
                clicks.append((time.time(), m.x, m.y, "right" if wp == WM_RBUTTONDOWN else "left"))
            return u.CallNextHookEx(None, n, wp, lp)

        def held(vk):
            return bool(u.GetAsyncKeyState(vk) & 0x8000)

        def on_key(n, wp, lp):
            # nothing while the watcher's own password box is up: its Enter is not a step, and its letters never are
            if n == HC_ACTION and wp in (WM_KEYDOWN, WM_SYSKEYDOWN) and not self.asking:
                vk = ctypes.cast(lp, ctypes.POINTER(KBLL)).contents.vk
                ctrl, alt = held(0x11), held(0x12)
                name = _VK_NAME.get(vk)
                # the named keys, and a letter or a number only with Ctrl or Alt held (a shortcut, never typing)
                if name is None and (ctrl or alt) and (0x30 <= vk <= 0x39 or 0x41 <= vk <= 0x5A):
                    name = chr(vk).lower()
                # the watcher's own Ctrl+Shift+F9 to F12 are never steps
                if name is not None and not (ctrl and held(0x10) and name in ("f9", "f10", "f11", "f12")):
                    mods = [m for m, v in (("ctrl", 0x11), ("alt", 0x12), ("shift", 0x10)) if held(v)]
                    self.events.append({"t": time.time(), "kind": "key", "keys": "+".join(mods + [name])})
            return u.CallNextHookEx(None, n, wp, lp)
        mh, kh = HOOK(on_mouse), HOOK(on_key)
        m_hook = u.SetWindowsHookExW(WH_MOUSE_LL, mh, k.GetModuleHandleW(None), 0)
        k_hook = u.SetWindowsHookExW(WH_KEYBOARD_LL, kh, k.GetModuleHandleW(None), 0)
        MOD_CONTROL, MOD_SHIFT = 0x0002, 0x0004
        u.RegisterHotKey(None, 0x4211, MOD_CONTROL | MOD_SHIFT, 0x7A)   # F11 finish
        u.RegisterHotKey(None, 0x4210, MOD_CONTROL | MOD_SHIFT, 0x79)   # F10 stop
        u.RegisterHotKey(None, 0x4209, MOD_CONTROL | MOD_SHIFT, 0x78)   # F9 a password
        msg = wintypes.MSG()
        try:
            while not self.done.is_set():
                while u.PeekMessageW(ctypes.byref(msg), None, 0, 0, 1):
                    if msg.message == WM_HOTKEY:
                        if msg.wParam == 0x4211:
                            self.done.set()
                        elif msg.wParam == 0x4210:
                            self.cancelled = True
                            self.done.set()
                        elif msg.wParam == 0x4209:
                            self.asking = True
                            try:
                                got = self._ask_password()
                            finally:
                                self.asking = False
                            if got:
                                _Secrets().set(got["name"], got["value"])
                                time.sleep(0.3)             # the program's own box has the keyboard back
                                self.osx.type_text(got["value"])
                                self.events.append({"t": time.time(), "kind": "secret", "name": got["name"]})
                    u.TranslateMessage(ctypes.byref(msg))
                    u.DispatchMessageW(ctypes.byref(msg))
                # each click, worked out off the hook (a hook that takes long is dropped by Windows)
                while clicks:
                    t, x, y, button = clicks.pop(0)
                    hwnd = u.GetAncestor(u.WindowFromPoint(wintypes.POINT(x, y)), 2)   # GA_ROOT
                    if int(hwnd or 0) in self.own:
                        continue
                    n = u.GetWindowTextLengthW(hwnd)
                    buf = ctypes.create_unicode_buffer(n + 1)
                    u.GetWindowTextW(hwnd, buf, n + 1)
                    rc = wintypes.RECT()
                    u.GetWindowRect(hwnd, ctypes.byref(rc))
                    pid = wintypes.DWORD()
                    u.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
                    label, look = _look_at(self.osx, x, y)
                    self.events.append({"t": t, "kind": "click", "x": x, "y": y, "button": button, "title": buf.value,
                                        "rect": (rc.left, rc.top, rc.right, rc.bottom), "program": self.osx.program_of(pid.value),
                                        "label": label, "look": look})
                time.sleep(0.02)
        finally:
            for hid in (0x4211, 0x4210, 0x4209):
                u.UnregisterHotKey(None, hid)
            u.UnhookWindowsHookEx(m_hook)
            u.UnhookWindowsHookEx(k_hook)


def _routine_hotkeys(host):
    """Each routine's hotkey, registered on this PC; the set follows the routines the unit sends."""
    if not sys.platform.startswith("win"):
        return
    from ctypes import wintypes
    u = ctypes.windll.user32
    MODS = {"ctrl": 0x0002, "alt": 0x0001, "shift": 0x0004}
    have, msg = {}, wintypes.MSG()
    while True:
        try:
            want = dict((str((r.get("triggers") or {}).get("hotkey") or ""), r) for r in host.routines if (r.get("triggers") or {}).get("hotkey"))
            for hk in [h for h in have if h not in want]:
                u.UnregisterHotKey(None, have.pop(hk)[0])
            for hk, r in want.items():
                if hk not in have:
                    parts = hk.split("+")
                    mods = sum(MODS[p] for p in parts[:-1]) | 0x4000          # MOD_NOREPEAT
                    hid = 0x5000 + len(have) + 1
                    if u.RegisterHotKey(None, hid, mods, key_vks(parts[-1])[0]):
                        have[hk] = (hid, r)
            while u.PeekMessageW(ctypes.byref(msg), None, 0, 0, 1):
                if msg.message == 0x0312:
                    for hk, (hid, r) in list(have.items()):
                        if hid == msg.wParam:
                            current = want.get(hk, r)
                            threading.Thread(target=host.fire, args=(current, "hotkey"), daemon=True).start()
            time.sleep(0.1)
        except Exception:
            time.sleep(1)


def _routines_loop():
    """The routines side, started with the watcher when it has a bay key."""
    if not BAY_KEY or not sys.platform.startswith("win"):
        return
    try:
        host = RoutineHost(_WinOS())
    except Exception:
        return
    threading.Thread(target=_routine_hotkeys, args=(host,), daemon=True).start()
    while True:
        try:
            host.poll_once()
        except Exception:
            pass
        time.sleep(ROUTINE_POLL)


# ── MAIN LOOP ──────────────────────────────────────────────────────────────────
def tick(status):
    """One decision pass. Separated from the loop so the logic is testable.
    Returns a short string describing the action taken (used by tests/logs)."""
    global last_warned_booking, admin_override

    if status is None:
        # Server unreachable - do nothing visible; try again next poll.
        return "no-server"

    if status.get("active"):
        # A session is running: never blank, reset the staff override.
        admin_override = False
        close_blank_screens()

        mins_left = status.get("minsLeft")
        warn_at   = status.get("warnMins", WARN_MINS)
        bid       = status.get("bookingId")

        # EXTENDED PAST ITS WARNING (Oct 2026, from pilot facility's 09-27 addendum): the booking already warned
        # about has more time than the warning point again - staff added time - so its new end warns
        # once more. Only the seven status fields are read (maintainer, Sep 27); minsLeft never grows for a
        # session nobody extended, and an extension adds at least 30 minutes.
        if (bid and bid == last_warned_booking and mins_left is not None
                and mins_left > warn_at + 2):
            last_warned_booking = None
            save_warned(None)

        if (mins_left is not None and 0 < mins_left <= warn_at
                and bid and bid != last_warned_booking):
            last_warned_booking = bid
            save_warned(bid)   # a reboot inside the warning window does not show it again
            if status.get("hasNext"):
                show_wrapup_message(mins_left)
                return "warn-wrapup"
            else:
                show_extend_popup(mins_left)
                return "warn-extend"
        return "active"

    # No active session.
    mins_until = status.get("minsUntilNext")
    next_start = status.get("nextStart")

    if admin_override:
        return "override"  # staff said stay unblanked - resets when a session starts
    if mins_until is not None and mins_until <= UNLOCK_MINS:
        close_blank_screens()  # next group arriving soon
        return "unblank-soon"
    show_blank_screens(fmt12(next_start) if next_start else None)
    return "blank"


def main():
    global last_warned_booking, _hotkey_started
    if last_warned_booking is None:
        last_warned_booking = load_warned()
    if not _hotkey_started:
        _hotkey_started = True
        threading.Thread(target=_staff_hotkey, daemon=True).start()
        # the routines side, once, when this watcher was built with a bay key (Oct 21 2026)
        threading.Thread(target=_routines_loop, daemon=True).start()
    print(f"Session monitor started - {BAY_NAME} ({BAY_ID}) -> {SERVER_URL}")
    global _last_status
    while True:
        _last_status = get_status()
        tick(_last_status)
        time.sleep(CHECK_EVERY)


def fmt12(hhmm):
    """'14:30' -> '2:30 PM' for on-screen display."""
    try:
        h, m = map(int, hhmm.split(":"))
        ap = "AM" if h < 12 else "PM"
        h12 = h % 12 or 12
        return f"{h12}:{m:02d} {ap}"
    except Exception:
        return hhmm


if __name__ == "__main__":
    # Supervisor: if anything ever crashes the main loop, wait and restart it.
    # Combined with the at-logon scheduled task, the monitor is always running.
    while True:
        try:
            main()
        except Exception:
            time.sleep(10)
