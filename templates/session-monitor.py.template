import base64
import ctypes
import json

# Decode facility settings as data, never as Python source.
_config = json.loads(base64.b64decode("{{CONFIG_B64}}"))
SERVER_URL = _config["serverUrl"]
FALLBACK_URL = _config["fallbackUrl"]
BAY_ID = _config["bayId"]
BAY_NAME = _config["bayName"]
SITE_URL = _config["siteUrl"]
BUSINESS_NAME = _config["businessName"]
WARN_MINS = _config["warnMins"]
CHECK_EVERY = 30
UNLOCK_MINS = 10
