# ── SINGLE INSTANCE ──────────────────────────────────────────────────────────
# The monitor starts at EVERY sign-in (any account). If one is already
# running, this new copy exits quietly instead of stacking popups.
try:
    _mutex = ctypes.windll.kernel32.CreateMutexW(None, False, "SessionMonitor-" + BAY_ID)
    if ctypes.windll.kernel32.GetLastError() == 183:  # ERROR_ALREADY_EXISTS
        raise SystemExit(0)
except SystemExit:
    raise
except Exception:
    pass
